{
  "compiler_path": "x86_64-w64-mingw32-gcc",
  "compiler_std": "c++20",
  "headers_path": [
    "../",
    "./",
    "../../../public/",
    "../../../../nekrnl/private/libPOSIX/",
    "../../../../nekrnl/private/libSystem/",
    "../../../../nekrnl/private/libPThread/",
    "../../../../nekrnl/private/libThread/",
    "../../../../nekrnl/private/",
    "../../../../nekrnl/public/src",
    "../../../../nekrnl/private/libMsg/"
  ],
  "sources_path": [
    "src/*.cpp",
    "dbg_rsrc.obj"
  ],
  "output_name": "./dist/dbghost.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17",
    "-L../../../../nekrnl/private/libSystem/",
    "-lSystem"
  ],
  "cpp_macros": [
    "kNeDbgVersion=0x0100",
    "kNeDbgVersionHighest=0x0100",
    "kNeDbgVersionLowest=0x0100"
  ],
  "description": "The Ne.app NeAnt Debug Host Service."
}
