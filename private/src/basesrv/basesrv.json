{
  "compiler_path": "x86_64-w64-mingw32-gcc",
  "compiler_std": "c++20",
  "headers_path": [
    "../",
    "./",
    "../../../../krnl/private",
    "../../../../krnl/private/libSystem",
    "../../../../krnl/public/src"
  ],
  "sources_path": [
    "src/*.cpp"
  ],
  "output_name": "./dist/basesrv.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17",
    "-L../../../../krnl/private/libSystem",
    "-lSystem"
  ],
  "cpp_macros": [
    "kNeBaseVersion=0x0100",
    "kNeBaseVersionHighest=0x0100",
    "kNeBaseVersionLowest=0x0100"
  ],
  "description": "The Ne.app NeAnt Base Server."
}
